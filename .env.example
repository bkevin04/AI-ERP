# Postgres (app role, non-superuser; RLS applies)
DATABASE_URL=postgres://app:app@localhost:5432/app
# Postgres owner for migrations
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/app

# Anthropic (or run `ant auth login`)
ANTHROPIC_API_KEY=
LLM_TRIAGE_MODEL=claude-haiku-5-5
LLM_EXTRACT_MODEL=claude-opus-5-5
LLM_DISAMBIGUATE_MODEL=claude-opus-5-5

# Inbound email (Postmark inbound webhook basic-auth token)
POSTMARK_INBOUND_TOKEN=change-me

# Object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Odoo dev ERP
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_API_KEY=admin

# Global kill switch for all agents
AGENTS_GLOBAL_PAUSE=false
